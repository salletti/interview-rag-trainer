# Copier en .env puis adapter. Aucune valeur réelle ici.
# Lu par Docker Compose (interpolation) et, hors Docker, par runtime.settings
# (depuis backend/ : ../.env). Sans .env, les défauts de runtime.settings
# visent déjà la stack de développement (ports hôte ci-dessous).

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
EXTERNAL_TIMEOUT_SECONDS=2.0

# --- Ports exposés sur la machine hôte ---------------------------------------
# Décalés par rapport aux ports standards pour cohabiter avec d'autres
# projets locaux (ex. une autre stack sur 8000/5432/5173).
API_PORT=8010
FRONTEND_PORT=5180
POSTGRES_PORT=5440
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=interview_rag_trainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview_rag_trainer

# --- RabbitMQ ------------------------------------------------------------------
RABBITMQ_USER=interview_rag_trainer
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Qdrant --------------------------------------------------------------------
# QDRANT_API_KEY=            # vide en développement local

# --- Celery --------------------------------------------------------------------
# rpc:// réutilise RabbitMQ comme result backend : pas de Redis.
CELERY_RESULT_BACKEND=rpc://

# --- Knowledge Base : work queue durable --------------------------------------
# Défauts Proposed (docs/conception/bounded-contexts/knowledge-base-s0.md §7,
# §8.4), à ajuster sur mesure. Durées en secondes.
KB_WORK_BACKOFF_BASE_SECONDS=10
KB_WORK_BACKOFF_MAX_SECONDS=900
KB_WORK_LEASE_TTL_SECONDS=300
# KB_WORK_HEARTBEAT_INTERVAL_SECONDS=   # absent : lease / 3 ; doit rester < lease
KB_WORK_TIME_LIMIT_SECONDS=3600
KB_WORK_DISPATCH_INTERVAL_SECONDS=2
KB_WORK_DISPATCH_BATCH=50
KB_WORK_REDISPATCH_AFTER_SECONDS=600
# Plafond d'items en vol par file de travail (en S0 : knowledge_base.ingestion).
KB_WORK_MAX_IN_FLIGHT=2
KB_WORK_RECOVER_INTERVAL_SECONDS=30

# --- Knowledge Base : import des documents (S2) -------------------------------
# Taille maximale d'un original, en octets (ADR 0012 : 20 Mio). Au-delà : 413.
KB_MAX_UPLOAD_BYTES=20971520
# Racine du volume des blobs. Ignorée par Docker Compose (fixée au point de
# montage de kb_blobs) ; hors Docker, à pointer vers un répertoire inscriptible.
# KB_BLOB_ROOT=/var/lib/interview-rag-trainer/blobs
# Âge minimal (s) d'un blob qu'aucun document non purgé ne référence avant son
# nettoyage (S7, ADR 0012 : 24 h Proposed) ; le même délai protège les
# temporaires de dépôt (tmp/) et la quarantaine. Appliqué par la réconciliation.
KB_BLOB_ORPHAN_GRACE_SECONDS=86400

# --- Knowledge Base : embeddings et index (S4) --------------------------------
# Chunks encodés par appel au modèle (donc par upsert Qdrant) dans le worker
# d'ingestion. Défaut Proposed : 32.
KB_EMBEDDING_BATCH_SIZE=32
# Cache des poids du modèle (intfloat/multilingual-e5-base, ~1,1 Go). Ignoré
# par Docker Compose (fixé au point de montage du volume models_cache) ; hors
# Docker, à pointer vers un répertoire inscriptible (ex. backend/.cache/models).
# KB_MODELS_CACHE_DIR=/var/cache/interview-rag-trainer/models

# --- Knowledge Base : extraction PDF/DOCX (S6) ---------------------------------
# Poids de Docling PDF (layout heron, TableFormer : ~530 Mio), téléchargés à la
# première extraction d'un PDF. Ignoré par Docker Compose (fixé à
# models_cache/huggingface) ; hors Docker, le cache du Hub par défaut
# (~/.cache/huggingface) sert, ou un répertoire du projet (ex.
# backend/.cache/huggingface, celui de `make test-integration`).
# HF_HOME=/var/cache/interview-rag-trainer/models/huggingface
# Limite de 300 pages par PDF : constante du parseur (ADR 0012), pas une
# variable ; au-delà, la version échoue en TOO_MANY_PAGES.

# --- Knowledge Base : recherche (S5, O12) --------------------------------------
# Unités demandées à Qdrant à la première passe : limit x facteur (mesuré :
# sans effet sur la latence de 1 à 8). Passes de complément quand le contrôle
# SQL écarte des unités. Budget en tokens d'un passage reconstruit, au moins
# 508 (un chunk entier).
KB_SEARCH_OVERSAMPLING_FACTOR=2
KB_SEARCH_COMPLEMENT_PASSES=1
KB_MAX_PASSAGE_TOKENS=1024

# --- Knowledge Base : réconciliation et erreurs (S8) ---------------------------
# Période (s) du beat qui planifie un cycle de réconciliation : un work item
# par créneau, exécuté par worker_ingestion (sérialisé avec les extractions).
KB_RECONCILE_INTERVAL_SECONDS=300
# Indexations COMPLETED dont le manifest est revérifié dans Qdrant à chaque
# cycle (échantillon aléatoire ; 0 : aucune).
KB_RECONCILE_MANIFEST_SAMPLE_SIZE=20
# Réouvertures automatiques d'une purge FAILED ; au-delà, elle attend un rejeu
# explicite (POST /api/v1/knowledge-base/failures/{id}/retry).
KB_RECONCILE_MAX_PURGE_REOPENINGS=3
# Durée de vie (s) d'une clé d'idempotence (O15 : 24 h) ; purge par la
# réconciliation.
KB_IDEMPOTENCY_KEY_TTL_SECONDS=86400
# Borne du texte extrait d'un document, tous formats (O16) : somme des tokens
# de ses unités ; au-delà, la version échoue en DOCUMENT_TOO_LARGE (terminal).
# Un PDF dense de 300 pages fait ~400 000 tokens (knowledge-base.md §16).
KB_MAX_DOCUMENT_TOKENS=1000000
# Tâches avant remplacement du processus enfant de worker_ingestion (option
# Celery --max-tasks-per-child, lue par Docker Compose seulement) : borne la
# croissance du pic de RSS sur des conversions PDF successives (S6, O5).
KB_INGESTION_MAX_TASKS_PER_CHILD=50
